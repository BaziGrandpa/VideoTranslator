{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue_id": { "type": "integer" },
          "subcues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "end_token_id": { "type": "integer" },
                "target_text": { "type": "string" }
              },
              "required": ["end_token_id", "target_text"],
              "additionalProperties": false
            }
          }
        },
        "required": ["cue_id", "subcues"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cues"],
  "additionalProperties": false
}
