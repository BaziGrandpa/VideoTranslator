{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "overview": { "type": "string" },
    "style": { "type": "string" },
    "preferred_terms": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        },
        "required": ["source", "target"],
        "additionalProperties": false
      }
    }
  },
  "required": ["overview", "style", "preferred_terms"],
  "additionalProperties": false
}
