  "type": "object",
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "chinese_term": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "required": ["source", "chinese_term", "explanation"],
