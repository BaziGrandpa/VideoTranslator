{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_sentence_id": { "type": "integer" },
          "chinese_sentence": { "type": "string" }
        },
        "required": ["source_sentence_id", "chinese_sentence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sentences"],
  "additionalProperties": false
}
