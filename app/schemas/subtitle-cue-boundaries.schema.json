{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue_id": { "type": "integer" },
          "boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "subcue_id": { "type": "integer" },
                "end_token_id": { "type": "integer" }
              },
              "required": ["subcue_id", "end_token_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["cue_id", "boundaries"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cues"],
  "additionalProperties": false
}
