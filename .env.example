# Translation uses your locally logged-in subscription CLIs, never an API key.
TRANSLATION_PROVIDERS=codex,grok
CODEX_CLI=codex
GROK_CLI=grok
# Leave blank to use each CLI's configured/default model.
CODEX_MODEL=
CODEX_REASONING_EFFORT=high
GROK_MODEL=
TRANSLATION_TIMEOUT_SECONDS=1800
VIDEO_TRANSLATOR_OUTPUT_DIR=output

# Video / ASR defaults
# Legacy setting: currently unused by project creation. Select height in the UI.
MAX_VIDEO_HEIGHT=1080
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Use h264_qsv for Intel GPU encoding or h264_nvenc for NVIDIA GPU encoding.
RENDER_VIDEO_ENCODER=libx264

# Rendering
# Initial/fallback style only. Saved project styles and app defaults take precedence.
# Browser timing preview is approximate; exact preview and final video share FFmpeg settings.
CHINESE_SUBTITLE_FONT=Microsoft YaHei
CHINESE_SUBTITLE_SIZE=46
CHINESE_SUBTITLE_COLOR=#FFFFFF
CHINESE_SUBTITLE_OUTLINE=3
ENGLISH_SUBTITLE_FONT=Arial
ENGLISH_SUBTITLE_SIZE=28
ENGLISH_SUBTITLE_COLOR=#D8D8D8
ENGLISH_SUBTITLE_OUTLINE=2
SUBTITLE_BOTTOM_MARGIN=46
SUBTITLE_LINE_GAP=66
SUBTITLE_HORIZONTAL_MARGIN=90
# Bottom mask values use 0.0-1.0 ratios.
BOTTOM_MASK_HEIGHT=0.34
BOTTOM_MASK_OPACITY=0.72
APP_HOST=127.0.0.1
APP_PORT=6866
